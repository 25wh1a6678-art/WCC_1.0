# Focus Contract Environment Variables
# Copy this file to .env.local and fill in your Supabase project credentials

# Supabase Public Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key for admin scripts only (NEVER expose to client!)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
