{
  "manifest_version": 3,
  "name": "Focus Contract Guard",
  "version": "1.0.0",
  "description": "Blocks selected distraction domains during an active focus session.",
  "permissions": ["storage", "tabs", "webRequest", "webRequestBlocking"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Focus Contract Guard",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
